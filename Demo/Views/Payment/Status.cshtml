@model Demo.Models.DatSan
@{
    ViewBag.Title = "Kết quả đặt sân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-white text-center py-4 border-0">
                    @if (Model.TrangThai == "Đã thanh toán")
                    {
                        <i class="fa-solid fa-circle-check text-success" style="font-size: 4rem;"></i>
                        <h2 class="mt-3 fw-bold text-success">Thanh toán thành công!</h2>
                    }
                    else if (Model.TrangThai == "Chờ xác nhận")
                    {
                        <i class="fa-solid fa-clock text-warning" style="font-size: 4rem;"></i>
                        <h2 class="mt-3 fw-bold text-warning">Đang chờ xác nhận</h2>
                    }
                    else
                    {
                        <i class="fa-solid fa-circle-info text-primary" style="font-size: 4rem;"></i>
                        <h2 class="mt-3 fw-bold text-primary">Trạng thái: @Model.TrangThai</h2>
                    }
                </div>

                <div class="card-body p-5">
                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-info text-center mb-4">
                            @TempData["Message"]
                        </div>
                    }

                    <h5 class="fw-bold mb-4 border-bottom pb-2">Chi tiết đơn đặt sân</h5>

                    <div class="row mb-3">
                        <div class="col-md-6 text-muted">Mã đơn hàng:</div>
                        <div class="col-md-6 fw-bold">@Model.MaDat</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6 text-muted">Sân bóng:</div>
                        <div class="col-md-6 fw-bold">@Model.MaSan</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6 text-muted">Ngày đặt:</div>
                        <div class="col-md-6 fw-bold">@Model.NgayDat.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6 text-muted">Tổng tiền:</div>
                        <div class="col-md-6 fw-bold text-danger">@String.Format("{0:N0} VNĐ", Model.TongTien)</div>
                    </div>

                    <div class="mt-5 d-flex justify-content-center gap-3">
                        <a href="@Url.Action("Index", "San")" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-arrow-left me-2"></i>Tiếp tục đặt sân
                        </a>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <a href="@Url.Action("MyBookings", "Bookings")" class="btn btn-primary px-4">
                                <i class="fa-solid fa-list-check me-2"></i>Xem lịch sử
                            </a>
                        }
                        else
                        {
                            <a href="#" class="btn btn-primary px-4" onclick="alert('Bạn không thể xem lịch sử khi chưa đăng nhập!'); return false;">
                                <i class="fa-solid fa-list-check me-2"></i>Xem lịch sử
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>