@model IEnumerable<Demo.Models.KHACHHANG>

@{
    ViewBag.Title = "Quản lý Khách Hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Danh sách Khách Hàng</h5>
        @Html.ActionLink("Thêm Khách Hàng", "CreateUser", "Admin", null, new { @class = "btn btn-success btn-sm rounded-pill px-3" })
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Avatar</th>
                        <th>Họ Tên</th>
                        <th>Email</th>
                        <th>SĐT</th>
                        <th>Ngày Tạo</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <img src="@(Url.Content(item.AnhDaiDien ?? "~/Content/images/default-avatar.png"))" width="40" height="40" class="rounded-circle" alt="@item.HoTen" />
                            </td>
                            <td class="fw-bold">@item.HoTen</td>
                            <td>@item.Email</td>
                            <td>@item.SDT</td>
                            <td>@(item.NgayTao.HasValue ? item.NgayTao.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td class="text-end pe-4">
                                @Html.ActionLink("Sửa", "EditUser", "Admin", new { id = item.MaKH }, new { @class = "btn btn-sm btn-outline-primary me-1" })
                                @Html.ActionLink("Xóa", "DeleteUser", "Admin", new { id = item.MaKH }, new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>