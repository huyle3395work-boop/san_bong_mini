@model Demo.Models.Trainer

@{
    ViewBag.Title = "Chỉnh sửa Huấn luyện viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.TrainerId)

    <div class="form-horizontal">
        <h4>Thông tin Huấn luyện viên</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(m => m.HoTen, "Họ tên", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.HoTen, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MoTaNgan, "Mô tả ngắn", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(m => m.MoTaNgan, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(m => m.MoTaNgan, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.KhuVuc, "Khu vực", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.KhuVuc, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.KhuVuc, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.AnhDaiDienUrl, "Link Ảnh (URL)", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.AnhDaiDienUrl, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.AnhDaiDienUrl, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.GiaMoiBuoi, "Giá/Buổi", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.GiaMoiBuoi, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.GiaMoiBuoi, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.SoNamKinhNghiem, "Kinh nghiệm (năm)", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.SoNamKinhNghiem, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.SoNamKinhNghiem, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.ChungChi, "Chứng chỉ", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(m => m.ChungChi, new { @class = "form-control", rows = 2 })
                @Html.ValidationMessageFor(m => m.ChungChi, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.AgeGroup, "Nhóm độ tuổi", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(m => m.AgeGroup,
                     new SelectList(new[] { "Chỉ trẻ em", "Chỉ người lớn", "Mọi lứa tuổi" }),
                     "Chọn nhóm tuổi",
                     new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.AgeGroup, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Services, "Dịch vụ cung cấp", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(m => m.Services, new { @class = "form-control", rows = 2 })
                @Html.ValidationMessageFor(m => m.Services, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.IsAcademy, "Là Academy?", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <br />
                @{
                    var isAcademyChecked = Model?.IsAcademy ?? false;
                }
                @Html.CheckBox("IsAcademy", isAcademyChecked, new { @class = "form-check-input" })
                @Html.ValidationMessageFor(m => m.IsAcademy)
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10 mt-3">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                @Html.ActionLink("Hủy", "ManageTrainers", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
}