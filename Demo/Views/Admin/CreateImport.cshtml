@{
    ViewBag.Title = "Nhập Kho Dịch Vụ";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Người nhập</label>
        <input name="NguoiNhap" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Ghi chú</label>
        <textarea name="GhiChu" class="form-control"></textarea>
    </div>

    <hr />
    <h4>Chi tiết nhập kho</h4>

    <table class="table table-bordered" id="tblImport">
        <thead>
            <tr>
                <th>Dịch vụ</th>
                <th>Số lượng</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Html.DropDownList("MaDV", ViewBag.DichVuList as SelectList, "-- Chọn --", new { @class = "form-control" })</td>
                <td><input type="number" name="SoLuongNhap" class="form-control" min="1" /></td>
                <td><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button></td>
            </tr>
        </tbody>
    </table>

    <button type="button" class="btn btn-secondary" onclick="addRow()">+ Thêm dịch vụ</button>

    <br />
    <br />
    <button type="submit" class="btn btn-primary">Lưu Phiếu Nhập</button>
    @Html.ActionLink("Hủy", "ManageImport", null, new { @class = "btn btn-secondary" })
}

<script>
    function addRow() {
        var row = document.querySelector("#tblImport tbody tr").cloneNode(true);
        row.querySelectorAll("input").forEach(i => i.value = "");
        document.querySelector("#tblImport tbody").appendChild(row);
    }

    function removeRow(btn) {
        var rows = document.querySelectorAll("#tblImport tbody tr");
        if (rows.length > 1) btn.closest("tr").remove();
    }
</script>
