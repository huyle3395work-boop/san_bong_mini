@model IEnumerable<Demo.Models.DichVu>
@{
    ViewBag.Title = "Quản lý dịch vụ";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Danh sách dịch vụ</h5>

        @Html.ActionLink("Thêm dịch vụ", "CreateService", "Admin", null, new { @class = "btn btn-success btn-sm rounded-pill px-3" })

    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Mã dịch vụ</th>
                        <th>Tên dịch vụ</th>
                        <th>Đơn vị tính</th>
                        <th>Số lượng tồn</th>
                        <th>Đơn giá</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.MaDV</td>
                            <td class="fw-bold">@item.TenDichVu</td>
                            <td class="fw-bold">@item.DonViTinh</td>
                            <td class="fw-bold">@item.SoLuongTon</td>
                            <td class="fw-bold">@item.DonGia</td>
                            <td class="text-end pe-4">
                                @Html.ActionLink("Sửa", "EditService", "Admin", new { id = item.MaDV }, new { @class = "btn btn-sm btn-outline-primary me-1" })

                                @Html.ActionLink("Xóa", "DeleteService", "Admin", new { id = item.MaDV }, new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>