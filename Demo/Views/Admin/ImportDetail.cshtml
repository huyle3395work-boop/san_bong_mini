@model IEnumerable<Demo.Models.ChiTietPhieuNhap>

@{
    ViewBag.Title = "Chi tiết Phiếu Nhập Kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var pn = ViewBag.PhieuNhap as Demo.Models.PhieuNhapDichVu;
}

<h2>Chi tiết Phiếu Nhập</h2>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <strong>Mã phiếu:</strong> @pn.MaPhieuNhap
            </div>
            <div class="col-md-4">
                <strong>Ngày nhập:</strong> @pn.NgayNhap.Value.ToString("dd/MM/yyyy HH:mm")

            </div>
            <div class="col-md-4">
                <strong>Người nhập:</strong> @pn.NguoiNhap
            </div>
        </div>

        @if (!string.IsNullOrEmpty(pn.GhiChu))
        {
            <hr />
            <strong>Ghi chú:</strong>
            <p>@pn.GhiChu</p>
        }
    </div>
</div>

<h4>Danh sách dịch vụ nhập</h4>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Mã DV</th>
            <th>Tên dịch vụ</th>
            <th>Số lượng nhập</th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 1;
            foreach (var ct in Model)
            {
                <tr>
                    <td>@i</td>
                    <td>@ct.MaDV</td>
                    <td>@ct.DichVu.TenDichVu</td>
                    <td class="text-end">@ct.SoLuongNhap</td>
                </tr>
                i++;
            }
        }
    </tbody>
</table>

<div class="mt-3">
    @Html.ActionLink("← Quay lại danh sách", "ManageImport", null, new { @class = "btn btn-secondary" })
</div>
