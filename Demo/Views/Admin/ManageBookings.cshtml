@model IEnumerable<Demo.Models.DatSan>

@{
    ViewBag.Title = "Quản lý Đơn Đặt Sân";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark">Danh sách Đơn Đặt Sân</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Mã Đơn</th>
                        <th>Người Đặt</th>
                        <th>Sân Đặt</th>
                        <th>Ngày Đặt</th>
                        <th>Khung Giờ</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">@item.MaDat</td>
                            <td>
                                @{
                                    var dictName = ViewBag.TenKhachHang as Dictionary<int, string>;
                                    string tenKhach = "Khách vãng lai";
                                    if (dictName != null && item.MaUser != null && dictName.ContainsKey(item.MaUser.Value))
                                    {
                                        tenKhach = dictName[item.MaUser.Value];
                                    }
                                }

                                <span class="fw-bold">@tenKhach</span>
                                <br />
                                <small class="text-muted">(@item.MaUser)</small>
                            </td>
                            <td>@(item.SanTheThao?.TenSan ?? "N/A")</td>
                            <td>@item.NgayDat.ToString("dd/MM/yyyy")</td>
                            <td>
                                @(item.KhungGio != null ?
                                item.KhungGio.GioBatDau.ToString(@"hh\:mm") + " - " + item.KhungGio.GioKetThuc.ToString(@"hh\:mm") : "N/A")
                            </td>
                            <td class="text-primary fw-bold">
                                @string.Format("{0:N0}", item.TongTien) đ
                            </td>
                            <td>
                                @{
                                    string badgeClass = "";
                                    switch (item.TrangThai)
                                    {
                                        case "Đã thanh toán":
                                            badgeClass = "bg-success";
                                            break;
                                        case "Đã xác nhận":
                                            badgeClass = "bg-info";
                                            break;
                                        case "Chờ xác nhận":
                                            badgeClass = "bg-warning";
                                            break;
                                        case "Đã hủy":
                                            badgeClass = "bg-danger";
                                            break;
                                        default:
                                            badgeClass = "bg-secondary";
                                            break;
                                    }
                                }
                                <span class="badge @badgeClass">@item.TrangThai</span>
                            </td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("Details", "Admin", new { id = item.MaDat })" class="btn btn-sm btn-outline-info me-1" title="Chi tiết">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                @if (item.TrangThai != "Đã thanh toán" && item.TrangThai != "Đã hủy")
                                {
                                    if (item.TrangThai == "Chờ xác nhận")
                                    {
                                        using (Html.BeginForm("ConfirmBooking", "Admin", new { id = item.MaDat }, FormMethod.Post, new { @class = "d-inline-block" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success me-1" title="Xác nhận" onclick="return confirm('Xác nhận đơn đặt sân này?')"><i class="fa-solid fa-check"></i></button>
                                        }
                                    }

                                    using (Html.BeginForm("CancelBooking", "Admin", new { id = item.MaDat }, FormMethod.Post, new { @class = "d-inline-block" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" title="Hủy" onclick="return confirm('Bạn có chắc chắn muốn hủy đơn này?')"><i class="fa-solid fa-xmark"></i></button>
                                    }

                                    using (Html.BeginForm("MarkAsPaid", "Admin", new { id = item.MaDat }, FormMethod.Post, new { @class = "d-inline-block ms-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-warning text-dark" title="Xác nhận đã thanh toán" onclick="return confirm('Xác nhận khách đã thanh toán tiền?')">
                                            <i class="fa-solid fa-sack-dollar"></i>
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>