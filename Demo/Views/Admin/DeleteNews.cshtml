@model Demo.Models.TinTuc

@{
    ViewBag.Title = "Xác nhận Xóa Tin Tức";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Xác nhận Xóa</h2>

<h3>Bạn có chắc chắn muốn xóa tin tức này không?</h3>
<div>
    <h4>Tin Tức: @Model.TieuDe</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Ngày Đăng</dt>
        <dd>@Model.NgayDang?.ToString("dd/MM/yyyy")</dd>

        <dt>Tác Giả</dt>
        <dd>@Html.DisplayFor(model => model.TacGia)</dd>

        <dt>Mô tả ngắn</dt>
        <dd>@Html.DisplayFor(model => model.MoTaNgan)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xóa Vĩnh Viễn" class="btn btn-danger" /> |
            @Html.ActionLink("Quay lại danh sách", "ManageNews")
        </div>
    }
</div>
